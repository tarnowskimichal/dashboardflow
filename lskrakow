<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>Liberating Structures Kraków</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;700&family=Figtree:wght@400;500;600;700&display=swap">
<style>
/* Layout: nagłówek z postępem i filtrami, pod spodem pozioma tablica 4 kolumn.
   Backlog przylega do lewej krawędzi, trzy kolumny organizatorów mają po 3 swimlane'y. */
:root {
  --font-display: 'Bricolage Grotesque', ui-sans-serif, system-ui, 'Segoe UI', sans-serif;
  --font-body: 'Figtree', ui-sans-serif, system-ui, 'Segoe UI', sans-serif;

  --bg: #F4F6F9;
  --surface: #FFFFFF;
  --col: #EBEEF3;
  --line: #DDE1E8;
  --line-strong: #C6CCD7;
  --ink: #1B2230;
  --ink-2: #4F596C;
  --ink-3: #7B869A;
  --btn-bg: #1B2230;
  --btn-fg: #FFFFFF;
  --focus: #2A5BD7;
  --danger: #C23B3B;
  --warn-bg: #FFF4DE;
  --warn-fg: #7A4D07;

  --st-before: #7458C9;
  --st-during: #B87410;
  --st-after: #B8467F;

  --s-todo: #7C8699;
  --s-doing: #2A5BD7;
  --s-done: #23864F;

  --shadow: 0 1px 2px rgba(20, 28, 45, .06), 0 1px 1px rgba(20, 28, 45, .04);
  --shadow-pop: 0 14px 34px rgba(20, 28, 45, .20), 0 2px 6px rgba(20, 28, 45, .10);
  --overlay: rgba(20, 26, 38, .45);
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #10141A; --surface: #1A1F29; --col: #151A22; --line: #2A3140; --line-strong: #3A4358;
    --ink: #E9ECF3; --ink-2: #A5AEC0; --ink-3: #7C869A;
    --btn-bg: #E9ECF3; --btn-fg: #10141A; --focus: #7FA0FF; --danger: #F07575;
    --warn-bg: #3A2D12; --warn-fg: #F2CF8A;
    --st-before: #A790F2; --st-during: #E0A140; --st-after: #E57DB0;
    --s-todo: #8D97AB; --s-doing: #7C9DFA; --s-done: #4DBE82;
    --shadow: 0 1px 2px rgba(0, 0, 0, .35);
    --shadow-pop: 0 14px 34px rgba(0, 0, 0, .55), 0 2px 6px rgba(0, 0, 0, .4);
    --overlay: rgba(0, 0, 0, .6);
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #10141A; --surface: #1A1F29; --col: #151A22; --line: #2A3140; --line-strong: #3A4358;
  --ink: #E9ECF3; --ink-2: #A5AEC0; --ink-3: #7C869A;
  --btn-bg: #E9ECF3; --btn-fg: #10141A; --focus: #7FA0FF; --danger: #F07575;
  --warn-bg: #3A2D12; --warn-fg: #F2CF8A;
  --st-before: #A790F2; --st-during: #E0A140; --st-after: #E57DB0;
  --s-todo: #8D97AB; --s-doing: #7C9DFA; --s-done: #4DBE82;
  --shadow: 0 1px 2px rgba(0, 0, 0, .35);
  --shadow-pop: 0 14px 34px rgba(0, 0, 0, .55), 0 2px 6px rgba(0, 0, 0, .4);
  --overlay: rgba(0, 0, 0, .6);
  color-scheme: dark;
}

* { box-sizing: border-box; }
body {
  background: var(--bg);
  color: var(--ink);
  font-family: var(--font-body);
  font-size: 14px;
  line-height: 1.45;
  padding-block: 20px 28px;
  padding-left: max(16px, env(safe-area-inset-left, 0px));
  padding-right: max(16px, env(safe-area-inset-right, 0px));
  display: flex;
  flex-direction: column;
  gap: 14px;
}
button, select, input, textarea { font: inherit; color: inherit; }
button { cursor: pointer; }
:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
.sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

/* Nagłówek */
.top { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 12px 20px; }
.brand { min-width: 0; }
.eyebrow { margin: 0 0 2px; font-size: 11.5px; font-weight: 600; letter-spacing: .09em; text-transform: uppercase; color: var(--ink-3); }
h1 { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: clamp(24px, 4.6vw, 32px); line-height: 1.1; letter-spacing: -.01em; text-wrap: balance; }
.actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }

.btn {
  border: 1px solid var(--line-strong); background: var(--surface); color: var(--ink);
  border-radius: 8px; padding: 8px 13px; font-weight: 600; font-size: 13.5px; line-height: 1.2;
  transition: background .15s, border-color .15s;
}
.btn:hover { border-color: var(--ink-2); }
.btn.primary { background: var(--btn-bg); color: var(--btn-fg); border-color: var(--btn-bg); padding: 9px 15px; font-size: 14px; }
.btn.primary:hover { opacity: .88; }
.btn.danger { color: var(--danger); border-color: color-mix(in srgb, var(--danger) 45%, var(--line-strong)); }
.btn.danger.solid { background: var(--danger); border-color: var(--danger); color: #fff; }
.btn.ghost { background: transparent; border-color: transparent; color: var(--ink-2); text-decoration: underline; text-underline-offset: 3px; padding-inline: 6px; }
.btn.ghost:disabled { opacity: .4; cursor: default; text-decoration: none; }
.btn:disabled { cursor: default; }

.badge {
  display: inline-flex; align-items: center; gap: 7px; padding: 6px 11px; border-radius: 999px;
  border: 1px solid var(--line-strong); background: var(--surface); color: var(--ink-2);
  font-size: 12.5px; font-weight: 600;
}
.badge .bdot { width: 8px; height: 8px; border-radius: 50%; background: var(--s-done); }
.badge.warn { background: var(--warn-bg); color: var(--warn-fg); border-color: transparent; }
.badge.warn .bdot { background: var(--st-during); }

/* Podsumowanie */
.summary {
  background: var(--surface); border: 1px solid var(--line); border-radius: 12px; box-shadow: var(--shadow);
  padding: 14px 18px; display: flex; flex-wrap: wrap; align-items: center; gap: 14px 32px;
}
.prog { display: flex; align-items: center; gap: 16px; flex: 1 1 280px; min-width: 0; }
.pct { font-family: var(--font-display); font-weight: 700; font-size: 40px; line-height: 1; min-width: 3.1ch; font-variant-numeric: tabular-nums; }
.prog-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 7px; }
.prog-label { font-size: 12.5px; color: var(--ink-2); font-weight: 500; }
.bar { height: 8px; border-radius: 999px; background: var(--col); overflow: hidden; }
.bar span { display: block; height: 100%; width: 0; background: var(--s-done); border-radius: 999px; transition: width .35s ease; }
.counters { margin: 0; display: flex; flex-wrap: wrap; gap: 10px 26px; }
.counters > div { display: flex; flex-direction: column; gap: 1px; min-width: 70px; }
.counters dt { font-size: 12px; color: var(--ink-2); font-weight: 500; display: flex; align-items: center; gap: 6px; }
.counters dt::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--c, var(--ink-3)); }
.counters dd { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: 24px; line-height: 1.1; font-variant-numeric: tabular-nums; }
.counters [data-s="todo"] { --c: var(--s-todo); }
.counters [data-s="doing"] { --c: var(--s-doing); }
.counters [data-s="done"] { --c: var(--s-done); }
.counters [data-s="all"] { --c: var(--ink); }

/* Filtry */
.filters { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 10px 12px; }
.filters label { display: flex; flex-direction: column; gap: 3px; font-size: 11.5px; font-weight: 600; color: var(--ink-3); letter-spacing: .04em; text-transform: uppercase; }
.filters select {
  font-size: 13.5px; font-weight: 500; letter-spacing: 0; text-transform: none; color: var(--ink);
  border: 1px solid var(--line-strong); background: var(--surface); border-radius: 8px; padding: 7px 28px 7px 10px; min-width: 140px;
}
.shown { margin-left: auto; font-size: 12.5px; color: var(--ink-2); padding-bottom: 8px; font-variant-numeric: tabular-nums; }

/* Tablica */
.board {
  display: flex; align-items: stretch; gap: 12px; overflow-x: auto; overflow-y: hidden;
  height: clamp(500px, calc(100dvh - 330px), 940px);
  padding-bottom: 8px; overscroll-behavior-x: contain; scrollbar-width: thin;
}
.col {
  flex: 0 0 clamp(272px, 82vw, 318px); display: flex; flex-direction: column; min-height: 0;
  background: var(--col); border: 1px solid var(--line); border-radius: 12px;
}
.col-h { display: flex; align-items: center; gap: 10px; padding: 12px 14px; border-bottom: 1px solid var(--line); }
.avatar {
  width: 30px; height: 30px; border-radius: 50%; flex: none; display: grid; place-items: center;
  background: var(--surface); border: 1px solid var(--line-strong);
  font-family: var(--font-display); font-weight: 700; font-size: 14px; color: var(--ink);
}
.avatar svg { width: 15px; height: 15px; stroke: var(--ink-2); fill: none; stroke-width: 1.8; stroke-linecap: round; }
.col-h h2 { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: 17px; line-height: 1.15; }
.col-h .sub { font-size: 12px; color: var(--ink-2); font-variant-numeric: tabular-nums; }
.col-body { flex: 1; min-height: 0; overflow-y: auto; padding: 10px; display: flex; flex-direction: column; gap: 14px; scrollbar-width: thin; }
.col.backlog { background: var(--col); border-color: var(--line-strong); }

.lane { display: flex; flex-direction: column; gap: 6px; }
.lane-h { display: flex; align-items: center; gap: 7px; padding: 0 2px; }
.lane-h .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--stage); flex: none; }
.lane-h h3 { margin: 0; font-size: 10.5px; font-weight: 700; letter-spacing: .09em; color: var(--ink-2); }
.count { font-size: 11.5px; color: var(--ink-3); font-variant-numeric: tabular-nums; }
.lane-add {
  margin-left: auto; width: 24px; height: 24px; border-radius: 6px; border: 1px solid transparent; background: transparent;
  color: var(--ink-2); font-size: 17px; line-height: 1; display: grid; place-items: center; padding: 0;
}
.lane-add:hover { background: var(--surface); border-color: var(--line-strong); }
.lane-body { display: flex; flex-direction: column; gap: 6px; min-height: 54px; border-radius: 9px; padding: 2px; transition: background .12s; }
.lane.over .lane-body { background: color-mix(in srgb, var(--stage) 13%, transparent); outline: 1.5px dashed var(--stage); outline-offset: -1px; }
.empty { border: 1px dashed var(--line-strong); border-radius: 8px; padding: 14px 8px; text-align: center; color: var(--ink-3); font-size: 12px; }

/* Karty */
.card {
  background: var(--surface); border: 1px solid var(--line); border-radius: 8px; box-shadow: var(--shadow);
  padding: 8px 8px 8px 10px; display: flex; flex-direction: column; gap: 6px; cursor: grab;
}
.card.dragging { opacity: .4; }
.card-top { display: flex; align-items: flex-start; gap: 4px; }
.card-title {
  flex: 1; min-width: 0; background: none; border: 0; padding: 1px 0; text-align: left;
  font-weight: 600; font-size: 13px; line-height: 1.35; color: var(--ink); overflow-wrap: anywhere;
}
.card-title:hover { text-decoration: underline; text-decoration-color: var(--line-strong); text-underline-offset: 3px; }
.card[data-status="done"] .card-title { color: var(--ink-3); text-decoration: line-through; text-decoration-color: var(--line-strong); }
.card[data-status="done"] { background: color-mix(in srgb, var(--surface) 70%, var(--col)); }
.icon-btn {
  flex: none; width: 26px; height: 26px; border-radius: 6px; border: 0; background: transparent; color: var(--ink-3);
  display: grid; place-items: center; padding: 0; margin-top: -2px;
}
.icon-btn:hover { background: var(--col); color: var(--ink); }
.icon-btn svg { width: 16px; height: 16px; fill: currentColor; }
.desc {
  margin: 0; font-size: 12px; color: var(--ink-2); line-height: 1.4;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; overflow-wrap: anywhere;
}
.meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 8px; padding-right: 2px; }
.status { position: relative; display: inline-flex; align-items: center; color: var(--ink); }
.status::before {
  content: ""; position: absolute; left: 8px; width: 8px; height: 8px; border-radius: 50%; background: var(--c); pointer-events: none;
}
.status::after {
  content: ""; position: absolute; right: 8px; pointer-events: none;
  border-left: 3.5px solid transparent; border-right: 3.5px solid transparent; border-top: 4px solid currentColor; opacity: .7;
}
.status select {
  appearance: none; -webkit-appearance: none; cursor: pointer;
  border-radius: 999px; border: 1px solid color-mix(in srgb, var(--c) 40%, transparent);
  background: color-mix(in srgb, var(--c) 12%, var(--surface));
  padding: 2px 22px 2px 22px; font-size: 11.5px; font-weight: 600; color: var(--ink);
}
.card[data-status="todo"] { --c: var(--s-todo); }
.card[data-status="doing"] { --c: var(--s-doing); }
.card[data-status="done"] { --c: var(--s-done); }
.tag { display: inline-flex; align-items: center; gap: 5px; font-size: 10.5px; font-weight: 700; letter-spacing: .07em; color: var(--ink-2); }
.tag::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--stage); }
.due { font-size: 11.5px; font-weight: 500; color: var(--ink-2); margin-left: auto; font-variant-numeric: tabular-nums; }
.due.over { color: var(--danger); font-weight: 700; }
.assign { display: flex; flex-wrap: wrap; align-items: center; gap: 5px; padding-top: 6px; border-top: 1px solid var(--line); }
.assign > span { font-size: 11.5px; color: var(--ink-3); margin-right: 1px; }
.assign button {
  border: 1px solid var(--line-strong); background: var(--surface); border-radius: 999px; padding: 2px 9px;
  font-size: 11.5px; font-weight: 600; color: var(--ink);
}
.assign button:hover { background: var(--btn-bg); color: var(--btn-fg); border-color: var(--btn-bg); }

/* Menu karty */
.menu {
  position: fixed; z-index: 60; width: 224px; max-height: calc(100dvh - 16px); overflow-y: auto;
  background: var(--surface); border: 1px solid var(--line-strong); border-radius: 10px; box-shadow: var(--shadow-pop); padding: 6px;
}
.menu-label { padding: 7px 10px 3px; font-size: 10.5px; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; color: var(--ink-3); }
.menu button {
  display: flex; width: 100%; align-items: center; justify-content: space-between; text-align: left;
  border: 0; background: none; border-radius: 6px; padding: 7px 10px; font-size: 13.5px;
}
.menu button:hover:not(:disabled) { background: var(--col); }
.menu button:disabled { color: var(--ink-3); cursor: default; }
.menu button[aria-checked="true"]::after { content: "✓"; font-weight: 700; color: var(--ink-2); }
.menu button.danger { color: var(--danger); }
.menu hr { border: 0; border-top: 1px solid var(--line); margin: 5px 0; }

/* Okna dialogowe */
.overlay {
  position: fixed; inset: 0; z-index: 80; background: var(--overlay); display: flex; align-items: center; justify-content: center;
  padding: max(16px, env(safe-area-inset-top, 0px)) max(16px, env(safe-area-inset-right, 0px)) max(16px, env(safe-area-inset-bottom, 0px)) max(16px, env(safe-area-inset-left, 0px));
}
.modal {
  background: var(--surface); border: 1px solid var(--line); border-radius: 14px; box-shadow: var(--shadow-pop);
  width: min(480px, 100%); max-height: 100%; overflow-y: auto; padding: 20px; display: flex; flex-direction: column; gap: 14px;
}
.modal h2 { margin: 0; font-family: var(--font-display); font-size: 20px; line-height: 1.2; }
.modal p { margin: 0; color: var(--ink-2); font-size: 13.5px; }
.modal .quote { color: var(--ink); font-weight: 600; overflow-wrap: anywhere; }
form { display: flex; flex-direction: column; gap: 12px; }
.field { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
.field > label { font-size: 12.5px; font-weight: 600; color: var(--ink-2); }
.field .opt { font-weight: 400; color: var(--ink-3); }
.field input, .field select, .field textarea {
  width: 100%; border: 1px solid var(--line-strong); background: var(--bg); border-radius: 8px; padding: 9px 10px; font-size: 14px;
}
.field textarea { resize: vertical; min-height: 64px; }
.field .err { color: var(--danger); font-size: 12px; min-height: 0; }
.row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.row2.three { grid-template-columns: 1fr 1fr; }
.btns { display: flex; flex-wrap: wrap; gap: 8px; justify-content: flex-end; align-items: center; }
.btns .left { margin-right: auto; }
.mono { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 12px !important; min-height: 120px; }
.note { background: var(--col); border-radius: 10px; padding: 11px 13px; font-size: 13px; color: var(--ink-2); display: flex; flex-direction: column; gap: 6px; }
.note strong { color: var(--ink); }
.note.warn { background: var(--warn-bg); color: var(--warn-fg); }
.note.warn strong { color: var(--warn-fg); }

.toast {
  position: fixed; left: 50%; transform: translateX(-50%); z-index: 90; max-width: min(92vw, 460px);
  bottom: calc(16px + env(safe-area-inset-bottom, 0px));
  background: var(--btn-bg); color: var(--btn-fg); padding: 9px 15px; border-radius: 10px; font-size: 13.5px; font-weight: 500; box-shadow: var(--shadow-pop);
}

@media (min-width: 900px) {
  .col.backlog { position: sticky; left: 0; z-index: 3; box-shadow: 10px 0 14px -10px rgba(20, 28, 45, .22); }
}
@media (max-width: 899px) {
  .board { scroll-snap-type: x proximity; }
  .col { scroll-snap-align: start; }
}
@media (max-width: 600px) {
  .field input, .field select, .field textarea, .filters select { font-size: 16px; }
  .filters label { flex: 1 1 140px; }
  .filters select { width: 100%; }
  .shown { margin-left: 0; width: 100%; padding-bottom: 0; }
  .row2 { grid-template-columns: 1fr; }
  .actions { width: 100%; }
  .actions .primary { margin-left: auto; }
}
@media (prefers-reduced-motion: reduce) {
  * { transition: none !important; }
}
</style>

<header class="top">
  <div class="brand">
    <p class="eyebrow">Tablica organizatorów meetupu</p>
    <h1>Liberating Structures Kraków</h1>
  </div>
  <div class="actions">
    <button class="badge" id="modeBadge" type="button"><span class="bdot"></span><span id="modeText">Prototyp lokalny</span></button>
    <button class="btn" id="dataBtn" type="button">Dane</button>
    <button class="btn primary" id="addBtn" type="button">+ Dodaj zadanie</button>
  </div>
</header>

<section class="summary" aria-label="Postęp prac">
  <div class="prog">
    <div class="pct" id="pct">0%</div>
    <div class="prog-main">
      <div class="prog-label">Ukończono <span id="progText">0 z 0</span> zadań</div>
      <div class="bar" id="bar" role="progressbar" aria-label="Postęp ukończenia" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span id="barFill"></span></div>
    </div>
  </div>
  <dl class="counters">
    <div data-s="all"><dt>Wszystkie</dt><dd id="cAll">0</dd></div>
    <div data-s="todo"><dt>Do zrobienia</dt><dd id="cTodo">0</dd></div>
    <div data-s="doing"><dt>W trakcie</dt><dd id="cDoing">0</dd></div>
    <div data-s="done"><dt>Gotowe</dt><dd id="cDone">0</dd></div>
  </dl>
</section>

<section class="filters" aria-label="Filtry">
  <label>Etap<select id="fStage"></select></label>
  <label>Organizator<select id="fOwner"></select></label>
  <label>Status<select id="fStatus"></select></label>
  <button class="btn ghost" id="fClear" type="button" disabled>Wyczyść filtry</button>
  <span class="shown" id="shown" aria-live="polite"></span>
</section>

<main class="board" id="board" tabindex="0" aria-label="Tablica zadań"></main>

<div class="menu" id="menu" role="menu" hidden></div>

<div class="overlay" id="taskOverlay" hidden>
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="taskTitle">
    <h2 id="taskTitle">Nowe zadanie</h2>
    <form id="taskForm" novalidate>
      <div class="field">
        <label for="f-title">Nazwa zadania</label>
        <input id="f-title" type="text" autocomplete="off">
        <div class="err" id="f-err" aria-live="polite"></div>
      </div>
      <div class="field">
        <label for="f-desc">Opis <span class="opt">(opcjonalnie)</span></label>
        <textarea id="f-desc" rows="3"></textarea>
      </div>
      <div class="row2">
        <div class="field"><label for="f-stage">Etap wydarzenia</label><select id="f-stage"></select></div>
        <div class="field"><label for="f-owner">Odpowiedzialny</label><select id="f-owner"></select></div>
      </div>
      <div class="row2">
        <div class="field"><label for="f-due">Termin <span class="opt">(opcjonalnie)</span></label><input id="f-due" type="date"></div>
        <div class="field"><label for="f-status">Status</label><select id="f-status"></select></div>
      </div>
      <div class="btns">
        <button class="btn danger left" id="f-delete" type="button" hidden>Usuń</button>
        <button class="btn" id="f-cancel" type="button">Anuluj</button>
        <button class="btn primary" id="f-save" type="submit">Dodaj zadanie</button>
      </div>
    </form>
  </div>
</div>

<div class="overlay" id="confirmOverlay" hidden>
  <div class="modal" role="alertdialog" aria-modal="true" aria-labelledby="cTitle">
    <h2 id="cTitle">Usunąć zadanie?</h2>
    <p class="quote" id="cName"></p>
    <p>Tej operacji nie można cofnąć.</p>
    <div class="btns">
      <button class="btn" id="c-cancel" type="button">Anuluj</button>
      <button class="btn danger solid" id="c-ok" type="button">Usuń zadanie</button>
    </div>
  </div>
</div>

<div class="overlay" id="dataOverlay" hidden>
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="dTitle">
    <h2 id="dTitle">Dane tablicy</h2>
    <div class="note warn" id="d-warn" hidden>
      <strong>Zapis w przeglądarce jest zablokowany.</strong>
      <span>Zmiany znikną po odświeżeniu strony (tak bywa w trybie prywatnym). Skopiuj dane poniżej, żeby ich nie stracić.</span>
    </div>
    <div class="note">
      <strong>Prototyp lokalny</strong>
      <span>Zadania zapisują się tylko w tej przeglądarce, na tym urządzeniu. Michał, Sylwia i Olena widzą każdy własną kopię.</span>
      <strong>Wersja ze wspólną synchronizacją</strong>
      <span>Ta sama tablica na wszystkich urządzeniach wymaga podłączonej bazy danych. Warstwa danych (TaskStore) jest oddzielona od interfejsu, więc wystarczy podmienić adapter zapisu.</span>
    </div>
    <div class="field">
      <label for="d-json">Kopia zadań (JSON)</label>
      <textarea class="mono" id="d-json" spellcheck="false"></textarea>
      <div class="err" id="d-err" aria-live="polite"></div>
    </div>
    <div class="btns">
      <button class="btn danger left" id="d-reset" type="button">Przywróć zadania startowe</button>
      <button class="btn" id="d-copy" type="button">Kopiuj</button>
      <button class="btn" id="d-import" type="button">Wczytaj z pola</button>
      <button class="btn primary" id="d-close" type="button">Zamknij</button>
    </div>
  </div>
</div>

<div class="toast" id="toast" role="status" aria-live="polite" hidden></div>

<script>
(function () {
  'use strict';

  /* ---------- Słowniki ---------- */
  var OWNERS = [
    { id: 'michal', name: 'Michał' },
    { id: 'sylwia', name: 'Sylwia' },
    { id: 'olena', name: 'Olena' }
  ];
  var STAGES = [
    { id: 'before', name: 'PRZED MEETUPEM', tag: 'PRZED' },
    { id: 'during', name: 'W TRAKCIE MEETUPU', tag: 'MEETUP' },
    { id: 'after', name: 'PO MEETUPIE', tag: 'PO' }
  ];
  var STATUSES = [
    { id: 'todo', name: 'Do zrobienia' },
    { id: 'doing', name: 'W trakcie' },
    { id: 'done', name: 'Gotowe' }
  ];
  var COLS = [{ id: 'backlog', name: 'Backlog zadań' }].concat(OWNERS);

  function find(list, id) { for (var i = 0; i < list.length; i++) if (list[i].id === id) return list[i]; return null; }
  function ownerName(id) { return id && id !== 'backlog' ? find(OWNERS, id).name : 'Backlog'; }
  function esc(s) {
    return String(s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; });
  }
  function uid() { return 't' + Date.now().toString(36) + Math.random().toString(36).slice(2, 7); }

  /* ---------- Zadania startowe (backlog, bez przypisania) ---------- */
  function seed() {
    var n = 0;
    function mk(stage, title, desc) {
      n += 1;
      return { id: 'seed' + n, title: title, desc: desc || '', stage: stage, owner: null, due: '', status: 'todo' };
    }
    return [
      mk('before', 'Ogłosić temat na wcześniejszym meetupie i przygotować grafikę zapowiadającą.'),
      mk('before', 'Zarezerwować termin w PEGA.'),
      mk('before', 'Przygotować merytoryczną część meetupu, w tym prezentację.'),
      mk('before', 'Zdecydować, czy meetup będzie tematyczny, czy skoncentrowany na Liberating Structures.'),
      mk('before', 'Utworzyć wydarzenie na Evenea.'),
      mk('before', 'Opublikować post otwierający zapisy.'),
      mk('before', 'Opublikować post przedstawiający prowadzących.'),
      mk('before', 'Opublikować post o partnerach.'),
      mk('before', 'Opublikować post zapowiadający meetup.'),
      mk('before', 'Opublikować posty „To już jutro!” i „To już dziś!”.'),
      mk('before', 'Opublikować post informujący o wyprzedaniu biletów, gdy wydarzenie osiągnie limit miejsc.'),
      mk('before', 'Utworzyć wydarzenie na LinkedIn i zaprosić znajomych.'),
      mk('before', 'Wysłać mail otwierający zapisy za pośrednictwem MailerLite.'),
      mk('before', 'Wysłać przypomnienie o wydarzeniu za pośrednictwem MailerLite do subskrybentów, którzy jeszcze się nie zapisali.', 'Termin: kilka dni przed wydarzeniem.'),
      mk('before', 'Wysłać mail organizacyjny „To już dziś!” za pośrednictwem MailerLite.'),
      mk('before', 'Przygotować formularz feedbacku z kodem QR.', 'Wcześniej ustalić z prowadzącymi, jakie informacje chcą uzyskać od uczestników.'),
      mk('before', 'Przygotować kod QR do Buy Me a Coffee i sprawdzić, czy poprzedni kod nadal działa.'),

      mk('during', 'Przywitać uczestników.'),
      mk('during', 'Monitorować maile od uczestników rezygnujących z udziału i odpowiadać na nie.'),
      mk('during', 'Opublikować na LinkedIn post z materiałem wideo z wydarzenia.'),
      mk('during', 'Przygotować post na następny dzień.'),
      mk('during', 'Opowiedzieć uczestnikom o społeczności Liberating Structures.'),
      mk('during', 'Zamknąć meetup i przekazać ogłoszenia organizacyjne.'),
      mk('during', 'Otworzyć meetup, przedstawić cel spotkania i rozpocząć agendę.'),

      mk('after', 'Opublikować post podsumowujący dzień po wydarzeniu.', 'W miarę możliwości przygotować go już podczas meetupu.'),
      mk('after', 'Wysłać mail podsumowujący za pośrednictwem MailerLite.'),
      mk('after', 'Opublikować dodatkowy post podsumowujący, na przykład przedstawiający wykorzystaną strukturę Liberating Structures.')
    ];
  }

  /* ---------- Warstwa danych ----------
     Interfejs rozmawia wyłącznie z TaskStore. Adapter odpowiada za trwały zapis.
     Dziś: LocalAdapter (localStorage, prototyp lokalny).
     Później: adapter ze wspólną bazą (load/save po sieci) o tym samym kształcie. */
  var STORAGE_KEY = 'lsk-krakow-meetup-board-v1';

  var LocalAdapter = {
    mode: 'local',
    load: function () {
      try {
        var raw = localStorage.getItem(STORAGE_KEY);
        if (raw) {
          var data = JSON.parse(raw);
          if (data && Array.isArray(data.tasks)) return data.tasks;
        }
      } catch (e) { /* brak dostępu lub uszkodzone dane */ }
      return null;
    },
    save: function (tasks) {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify({ version: 1, tasks: tasks }));
        return true;
      } catch (e) { return false; }
    }
  };

  function normalizeList(list) {
    var seen = {};
    return list.map(function (t) {
      var id = String((t && t.id) || '');
      if (!id || seen[id]) id = uid();
      seen[id] = true;
      t = t || {};
      return {
        id: id,
        title: String(t.title || '').trim() || 'Bez nazwy',
        desc: String(t.desc || '').trim(),
        stage: find(STAGES, t.stage) ? t.stage : 'before',
        owner: find(OWNERS, t.owner) ? t.owner : null,
        due: /^\d{4}-\d{2}-\d{2}$/.test(t.due || '') ? t.due : '',
        status: find(STATUSES, t.status) ? t.status : 'todo'
      };
    });
  }

  var TaskStore = (function (adapter) {
    var tasks = [];
    var subs = [];
    var persisted = true;
    function emit() { subs.forEach(function (fn) { fn(); }); }
    function commit() { persisted = adapter.save(tasks); emit(); }
    function indexOf(id) { for (var i = 0; i < tasks.length; i++) if (tasks[i].id === id) return i; return -1; }
    return {
      mode: adapter.mode,
      init: function () {
        var saved = adapter.load();
        tasks = normalizeList(saved || seed());
        if (!saved) persisted = adapter.save(tasks);
      },
      reload: function () {
        var saved = adapter.load();
        if (saved) { tasks = normalizeList(saved); emit(); }
      },
      subscribe: function (fn) { subs.push(fn); },
      isPersisted: function () { return persisted; },
      all: function () { return tasks.slice(); },
      get: function (id) { var i = indexOf(id); return i < 0 ? null : tasks[i]; },
      add: function (data) {
        var t = normalizeList([Object.assign({}, data, { id: uid() })])[0];
        tasks.push(t);
        commit();
        return t;
      },
      update: function (id, patch) {
        var i = indexOf(id);
        if (i < 0) return;
        tasks[i] = normalizeList([Object.assign({}, tasks[i], patch, { id: id })])[0];
        commit();
      },
      remove: function (id) {
        var i = indexOf(id);
        if (i < 0) return;
        tasks.splice(i, 1);
        commit();
      },
      /* opts: owner ('backlog' | id), stage, beforeId (wstaw przed kartą; brak = na koniec sekcji) */
      move: function (id, opts) {
        var i = indexOf(id);
        if (i < 0) return;
        var t = tasks[i];
        if (opts.beforeId === id) return;
        tasks.splice(i, 1);
        if ('owner' in opts) t.owner = opts.owner === 'backlog' ? null : opts.owner;
        if ('stage' in opts) t.stage = opts.stage;
        var j = opts.beforeId ? indexOf(opts.beforeId) : -1;
        if (j < 0) tasks.push(t); else tasks.splice(j, 0, t);
        commit();
      },
      replaceAll: function (list) {
        if (!Array.isArray(list)) return { ok: false, error: 'Dane muszą być listą zadań.' };
        for (var i = 0; i < list.length; i++) {
          if (!list[i] || typeof list[i].title !== 'string' || !list[i].title.trim()) {
            return { ok: false, error: 'Zadanie nr ' + (i + 1) + ' nie ma nazwy (pole "title").' };
          }
        }
        tasks = normalizeList(list);
        commit();
        return { ok: true, count: tasks.length };
      },
      reset: function () { tasks = normalizeList(seed()); commit(); },
      exportJson: function () { return JSON.stringify({ version: 1, tasks: tasks }, null, 2); }
    };
  })(LocalAdapter);

  /* ---------- Pomocnicze UI ---------- */
  var $ = function (id) { return document.getElementById(id); };
  var boardEl = $('board');
  var filters = { stage: 'all', owner: 'all', status: 'all' };

  function todayIso() {
    var n = new Date();
    return n.getFullYear() + '-' + String(n.getMonth() + 1).padStart(2, '0') + '-' + String(n.getDate()).padStart(2, '0');
  }
  function fmtDue(iso) {
    var p = iso.split('-').map(Number);
    var opts = { day: 'numeric', month: 'short' };
    if (p[0] !== new Date().getFullYear()) opts.year = 'numeric';
    return new Date(p[0], p[1] - 1, p[2]).toLocaleDateString('pl-PL', opts);
  }
  function matches(t) {
    return (filters.stage === 'all' || t.stage === filters.stage) &&
      (filters.owner === 'all' || (t.owner || 'backlog') === filters.owner) &&
      (filters.status === 'all' || t.status === filters.status);
  }
  function filtersActive() { return filters.stage !== 'all' || filters.owner !== 'all' || filters.status !== 'all'; }

  var toastTimer = null;
  function toast(msg) {
    var el = $('toast');
    el.textContent = msg;
    el.hidden = false;
    clearTimeout(toastTimer);
    toastTimer = setTimeout(function () { el.hidden = true; }, 2800);
  }

  function options(list, selected, extra) {
    var html = (extra || []).concat(list).map(function (o) {
      return '<option value="' + o.id + '"' + (o.id === selected ? ' selected' : '') + '>' + esc(o.name) + '</option>';
    }).join('');
    return html;
  }

  /* ---------- Render ---------- */
  function dueHtml(t) {
    var over = t.status !== 'done' && t.due < todayIso();
    return '<span class="due' + (over ? ' over' : '') + '" title="' + (over ? 'Termin minął' : 'Termin realizacji') + '">do ' + esc(fmtDue(t.due)) + '</span>';
  }

  function cardHtml(t) {
    var st = find(STAGES, t.stage);
    var assign = '';
    if (!t.owner) {
      assign = '<div class="assign" role="group" aria-label="Przypisz zadanie"><span>Przypisz:</span>' +
        OWNERS.map(function (o) {
          return '<button type="button" data-action="assign" data-owner="' + o.id + '">' + esc(o.name) + '</button>';
        }).join('') + '</div>';
    }
    return '<article class="card" draggable="true" data-id="' + esc(t.id) + '" data-status="' + t.status + '">' +
      '<div class="card-top">' +
        '<button type="button" class="card-title" data-action="edit" title="Edytuj zadanie">' + esc(t.title) + '</button>' +
        '<button type="button" class="icon-btn" data-action="menu" aria-haspopup="menu" aria-label="Więcej opcji zadania" title="Przenieś, edytuj, usuń">' +
          '<svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="3" cy="8" r="1.4"/><circle cx="8" cy="8" r="1.4"/><circle cx="13" cy="8" r="1.4"/></svg>' +
        '</button>' +
      '</div>' +
      (t.desc ? '<p class="desc" title="' + esc(t.desc) + '">' + esc(t.desc) + '</p>' : '') +
      '<div class="meta" style="--stage:var(--st-' + t.stage + ')">' +
        '<label class="status"><span class="sr-only">Status zadania</span>' +
          '<select data-action="status" aria-label="Status zadania">' + options(STATUSES, t.status) + '</select></label>' +
        '<span class="tag" title="' + esc(st.name) + '">' + st.tag + '</span>' +
        (t.due ? dueHtml(t) : '') +
      '</div>' + assign +
    '</article>';
  }

  function laneHtml(colId, stage, tasks) {
    var items = tasks.filter(function (t) { return (t.owner || 'backlog') === colId && t.stage === stage.id; });
    var shown = items.filter(matches);
    var empty = '';
    if (!shown.length) {
      empty = '<div class="empty">' + (items.length ? 'Brak pasujących zadań' : colId === 'backlog' ? 'Wszystko przypisane' : 'Brak zadań') + '</div>';
    }
    return '<section class="lane" data-owner="' + colId + '" data-stage="' + stage.id + '" style="--stage:var(--st-' + stage.id + ')">' +
      '<div class="lane-h"><span class="dot"></span><h3>' + stage.name + '</h3><span class="count">' + shown.length + '</span>' +
        '<button type="button" class="lane-add" data-action="add-lane" aria-label="Dodaj zadanie: ' + esc(ownerName(colId)) + ', ' + stage.name + '" title="Dodaj zadanie w tej sekcji">+</button></div>' +
      '<div class="lane-body">' + shown.map(cardHtml).join('') + empty + '</div>' +
    '</section>';
  }

  function colHtml(col, tasks) {
    var mine = tasks.filter(function (t) { return (t.owner || 'backlog') === col.id; });
    var done = mine.filter(function (t) { return t.status === 'done'; }).length;
    var isBacklog = col.id === 'backlog';
    var avatar = isBacklog
      ? '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2.5 4h11M2.5 8h11M2.5 12h7"/></svg>'
      : esc(col.name.charAt(0));
    var sub = isBacklog ? 'Nieprzypisane: ' + mine.length : 'Gotowe: ' + done + ' z ' + mine.length;
    return '<section class="col' + (isBacklog ? ' backlog' : '') + '" aria-label="' + esc(col.name) + '">' +
      '<div class="col-h"><span class="avatar">' + avatar + '</span><div><h2>' + esc(col.name) + '</h2><div class="sub">' + sub + '</div></div></div>' +
      '<div class="col-body">' + STAGES.map(function (s) { return laneHtml(col.id, s, tasks); }).join('') + '</div>' +
    '</section>';
  }

  function renderStats(tasks) {
    var total = tasks.length;
    var c = { todo: 0, doing: 0, done: 0 };
    tasks.forEach(function (t) { c[t.status] += 1; });
    var pct = total ? Math.round(c.done / total * 100) : 0;
    $('cAll').textContent = total;
    $('cTodo').textContent = c.todo;
    $('cDoing').textContent = c.doing;
    $('cDone').textContent = c.done;
    $('pct').textContent = pct + '%';
    $('progText').textContent = c.done + ' z ' + total;
    $('barFill').style.width = pct + '%';
    $('bar').setAttribute('aria-valuenow', String(pct));
  }

  function renderChrome(tasks) {
    var shownCount = tasks.filter(matches).length;
    $('shown').textContent = filtersActive() ? 'Pokazano ' + shownCount + ' z ' + tasks.length : '';
    $('fClear').disabled = !filtersActive();
    var ok = TaskStore.isPersisted();
    $('modeBadge').classList.toggle('warn', !ok);
    $('modeText').textContent = ok ? 'Prototyp lokalny' : 'Brak zapisu w przeglądarce';
    $('modeBadge').title = ok ? 'Dane zapisują się tylko w tej przeglądarce' : 'Przeglądarka blokuje zapis. Zmiany znikną po odświeżeniu.';
  }

  function render() {
    var tasks = TaskStore.all();
    var tops = Array.prototype.map.call(boardEl.querySelectorAll('.col-body'), function (el) { return el.scrollTop; });
    boardEl.innerHTML = COLS.map(function (col) { return colHtml(col, tasks); }).join('');
    Array.prototype.forEach.call(boardEl.querySelectorAll('.col-body'), function (el, i) { el.scrollTop = tops[i] || 0; });
    renderStats(tasks);
    renderChrome(tasks);
  }

  /* ---------- Okna ---------- */
  var lastFocus = null;
  function openOverlay(el, focusEl) {
    closeMenu();
    lastFocus = document.activeElement;
    el.hidden = false;
    if (focusEl) focusEl.focus();
  }
  function closeOverlays() {
    ['taskOverlay', 'confirmOverlay', 'dataOverlay'].forEach(function (id) { $(id).hidden = true; });
    resetArmed();
    if (lastFocus && lastFocus.isConnected && lastFocus.focus) lastFocus.focus();
    lastFocus = null;
  }
  function anyOverlayOpen() { return ['taskOverlay', 'confirmOverlay', 'dataOverlay'].some(function (id) { return !$(id).hidden; }); }

  var editingId = null;
  function openForm(opts) {
    opts = opts || {};
    var t = opts.id ? TaskStore.get(opts.id) : null;
    editingId = t ? t.id : null;
    $('taskTitle').textContent = t ? 'Edytuj zadanie' : 'Nowe zadanie';
    $('f-save').textContent = t ? 'Zapisz zmiany' : 'Dodaj zadanie';
    $('f-delete').hidden = !t;
    $('f-title').value = t ? t.title : '';
    $('f-desc').value = t ? t.desc : '';
    $('f-stage').innerHTML = options(STAGES, t ? t.stage : (opts.stage || 'before'));
    $('f-owner').innerHTML = options(OWNERS, t ? (t.owner || 'backlog') : (opts.owner || 'backlog'), [{ id: 'backlog', name: 'Nieprzypisane (backlog)' }]);
    $('f-due').value = t ? t.due : '';
    $('f-status').innerHTML = options(STATUSES, t ? t.status : 'todo');
    $('f-err').textContent = '';
    openOverlay($('taskOverlay'), $('f-title'));
  }

  $('taskForm').addEventListener('submit', function (e) {
    e.preventDefault();
    var title = $('f-title').value.trim();
    if (!title) {
      $('f-err').textContent = 'Wpisz nazwę zadania.';
      $('f-title').focus();
      return;
    }
    var owner = $('f-owner').value;
    var data = {
      title: title,
      desc: $('f-desc').value.trim(),
      stage: $('f-stage').value,
      owner: owner === 'backlog' ? null : owner,
      due: $('f-due').value,
      status: $('f-status').value
    };
    var result;
    if (editingId) {
      TaskStore.update(editingId, data);
      result = TaskStore.get(editingId);
      closeOverlays();
      toast('Zapisano zmiany');
    } else {
      result = TaskStore.add(data);
      closeOverlays();
      toast('Dodano zadanie: ' + ownerName(result.owner) + ', ' + find(STAGES, result.stage).name);
    }
    if (result && !matches(result)) toast('Zapisano. Zadanie jest ukryte przez aktywne filtry.');
  });
  $('f-cancel').addEventListener('click', closeOverlays);
  $('f-delete').addEventListener('click', function () { if (editingId) openConfirm(editingId); });
  $('addBtn').addEventListener('click', function () { openForm({}); });

  var deletingId = null;
  function openConfirm(id) {
    var t = TaskStore.get(id);
    if (!t) return;
    deletingId = id;
    $('cName').textContent = t.title;
    $('taskOverlay').hidden = true;
    var keep = lastFocus;
    openOverlay($('confirmOverlay'), $('c-cancel'));
    if (keep) lastFocus = keep;
  }
  $('c-cancel').addEventListener('click', closeOverlays);
  $('c-ok').addEventListener('click', function () {
    if (deletingId) TaskStore.remove(deletingId);
    deletingId = null;
    closeOverlays();
    toast('Usunięto zadanie');
  });

  /* Okno "Dane" */
  var armed = false, armTimer = null;
  function resetArmed() {
    armed = false;
    clearTimeout(armTimer);
    var b = $('d-reset');
    b.textContent = 'Przywróć zadania startowe';
    b.classList.remove('solid');
  }
  $('dataBtn').addEventListener('click', openData);
  $('modeBadge').addEventListener('click', openData);
  function openData() {
    $('d-json').value = TaskStore.exportJson();
    $('d-err').textContent = '';
    $('d-warn').hidden = TaskStore.isPersisted();
    resetArmed();
    openOverlay($('dataOverlay'), $('d-close'));
  }
  $('d-close').addEventListener('click', closeOverlays);
  $('d-copy').addEventListener('click', function () {
    var ta = $('d-json');
    function fallback() { ta.focus(); ta.select(); $('d-err').textContent = 'Zaznaczono dane. Skopiuj je skrótem Ctrl+C lub Cmd+C.'; }
    try {
      navigator.clipboard.writeText(ta.value).then(function () { $('d-err').textContent = ''; toast('Skopiowano dane'); }, fallback);
    } catch (e) { fallback(); }
  });
  $('d-import').addEventListener('click', function () {
    var parsed;
    try { parsed = JSON.parse($('d-json').value); }
    catch (e) { $('d-err').textContent = 'To nie jest poprawny JSON.'; return; }
    var list = Array.isArray(parsed) ? parsed : parsed && parsed.tasks;
    var res = TaskStore.replaceAll(list);
    if (!res.ok) { $('d-err').textContent = res.error; return; }
    closeOverlays();
    toast('Wczytano zadań: ' + res.count);
  });
  $('d-reset').addEventListener('click', function () {
    if (!armed) {
      armed = true;
      this.textContent = 'Na pewno? Kliknij ponownie';
      this.classList.add('solid');
      armTimer = setTimeout(resetArmed, 4000);
      return;
    }
    TaskStore.reset();
    closeOverlays();
    toast('Przywrócono zadania startowe');
  });

  ['taskOverlay', 'confirmOverlay', 'dataOverlay'].forEach(function (id) {
    $(id).addEventListener('mousedown', function (e) { if (e.target === this) closeOverlays(); });
  });

  /* ---------- Menu karty ---------- */
  var menuEl = $('menu');
  var menuTaskId = null;
  function closeMenu() { menuEl.hidden = true; menuTaskId = null; }
  function openMenu(id, btn) {
    var t = TaskStore.get(id);
    if (!t) return;
    menuTaskId = id;
    var cur = t.owner || 'backlog';
    var ownerItems = [{ id: 'backlog', name: 'Backlog (nieprzypisane)' }].concat(OWNERS).map(function (o) {
      return '<button type="button" role="menuitemradio" aria-checked="' + (o.id === cur) + '" data-act="owner" data-val="' + o.id + '"' + (o.id === cur ? ' disabled' : '') + '>' + esc(o.name) + '</button>';
    }).join('');
    var stageItems = STAGES.map(function (s) {
      return '<button type="button" role="menuitemradio" aria-checked="' + (s.id === t.stage) + '" data-act="stage" data-val="' + s.id + '"' + (s.id === t.stage ? ' disabled' : '') + '>' + s.name + '</button>';
    }).join('');
    menuEl.innerHTML =
      '<div class="menu-label">Przenieś do osoby</div>' + ownerItems +
      '<div class="menu-label">Zmień etap</div>' + stageItems +
      '<hr><button type="button" role="menuitem" data-act="edit">Edytuj…</button>' +
      '<button type="button" role="menuitem" class="danger" data-act="delete">Usuń…</button>';
    menuEl.hidden = false;
    var r = btn.getBoundingClientRect();
    var w = menuEl.offsetWidth, h = menuEl.offsetHeight;
    var left = Math.max(8, Math.min(r.right - w, window.innerWidth - w - 8));
    var top = r.bottom + 4;
    if (top + h > window.innerHeight - 8) top = Math.max(8, r.top - h - 4);
    menuEl.style.left = left + 'px';
    menuEl.style.top = top + 'px';
    var first = menuEl.querySelector('button:not(:disabled)');
    if (first) first.focus();
  }
  menuEl.addEventListener('click', function (e) {
    var b = e.target.closest('button[data-act]');
    if (!b || b.disabled) return;
    var id = menuTaskId;
    closeMenu();
    if (!id) return;
    var act = b.dataset.act, val = b.dataset.val;
    if (act === 'owner') { TaskStore.move(id, { owner: val }); toast('Przeniesiono do kolumny: ' + ownerName(val)); }
    else if (act === 'stage') { TaskStore.move(id, { stage: val }); toast('Zmieniono etap: ' + find(STAGES, val).name); }
    else if (act === 'edit') openForm({ id: id });
    else if (act === 'delete') openConfirm(id);
  });
  document.addEventListener('click', function (e) {
    if (!menuEl.hidden && !menuEl.contains(e.target) && !e.target.closest('[data-action="menu"]')) closeMenu();
  });
  document.addEventListener('scroll', function (e) { if (!menuEl.hidden && !menuEl.contains(e.target)) closeMenu(); }, true);
  window.addEventListener('resize', closeMenu);
  document.addEventListener('keydown', function (e) {
    if (e.key !== 'Escape') return;
    if (!menuEl.hidden) closeMenu();
    else if (anyOverlayOpen()) closeOverlays();
  });

  /* ---------- Zdarzenia tablicy ---------- */
  boardEl.addEventListener('click', function (e) {
    var el = e.target.closest('[data-action]');
    if (!el) return;
    var card = el.closest('.card');
    var id = card ? card.dataset.id : null;
    switch (el.dataset.action) {
      case 'edit': openForm({ id: id }); break;
      case 'menu':
        if (!menuEl.hidden && menuTaskId === id) closeMenu(); else openMenu(id, el);
        break;
      case 'assign':
        TaskStore.move(id, { owner: el.dataset.owner });
        toast('Przypisano: ' + ownerName(el.dataset.owner));
        break;
      case 'add-lane': {
        var lane = el.closest('.lane');
        openForm({ owner: lane.dataset.owner, stage: lane.dataset.stage });
        break;
      }
    }
  });

  boardEl.addEventListener('change', function (e) {
    var sel = e.target.closest('select[data-action="status"]');
    if (!sel) return;
    var id = sel.closest('.card').dataset.id;
    TaskStore.update(id, { status: sel.value });
    var again = boardEl.querySelector('.card[data-id="' + id + '"] select');
    if (again) again.focus();
  });

  /* Przeciąganie i upuszczanie */
  var dragId = null, overLane = null;
  function clearOver() {
    if (overLane) overLane.classList.remove('over');
    overLane = null;
  }
  boardEl.addEventListener('dragstart', function (e) {
    var card = e.target.closest && e.target.closest('.card');
    if (!card) return;
    dragId = card.dataset.id;
    closeMenu();
    e.dataTransfer.effectAllowed = 'move';
    try { e.dataTransfer.setData('text/plain', dragId); } catch (err) { /* ignoruj */ }
    requestAnimationFrame(function () { card.classList.add('dragging'); });
  });
  boardEl.addEventListener('dragend', function () {
    dragId = null;
    clearOver();
    Array.prototype.forEach.call(boardEl.querySelectorAll('.dragging'), function (c) { c.classList.remove('dragging'); });
  });
  boardEl.addEventListener('dragover', function (e) {
    if (!dragId) return;
    var lane = e.target.closest('.lane');
    if (!lane) return;
    e.preventDefault();
    e.dataTransfer.dropEffect = 'move';
    if (overLane !== lane) { clearOver(); lane.classList.add('over'); overLane = lane; }
  });
  boardEl.addEventListener('dragleave', function (e) {
    var lane = e.target.closest('.lane');
    if (lane && !lane.contains(e.relatedTarget)) {
      lane.classList.remove('over');
      if (overLane === lane) overLane = null;
    }
  });
  boardEl.addEventListener('drop', function (e) {
    if (!dragId) return;
    var lane = e.target.closest('.lane');
    if (!lane) return;
    e.preventDefault();
    var id = dragId;
    dragId = null;
    clearOver();
    var cards = Array.prototype.filter.call(lane.querySelectorAll('.card'), function (c) { return c.dataset.id !== id; });
    var before = null;
    for (var i = 0; i < cards.length; i++) {
      var r = cards[i].getBoundingClientRect();
      if (e.clientY < r.top + r.height / 2) { before = cards[i]; break; }
    }
    TaskStore.move(id, { owner: lane.dataset.owner, stage: lane.dataset.stage, beforeId: before ? before.dataset.id : null });
    toast('Przeniesiono: ' + ownerName(lane.dataset.owner) + ', ' + find(STAGES, lane.dataset.stage).name);
  });

  /* ---------- Filtry ---------- */
  $('fStage').innerHTML = options(STAGES, 'all', [{ id: 'all', name: 'Wszystkie etapy' }]);
  $('fOwner').innerHTML = options(OWNERS, 'all', [{ id: 'all', name: 'Wszyscy' }, { id: 'backlog', name: 'Backlog (nieprzypisane)' }]);
  $('fStatus').innerHTML = options(STATUSES, 'all', [{ id: 'all', name: 'Wszystkie statusy' }]);
  [['fStage', 'stage'], ['fOwner', 'owner'], ['fStatus', 'status']].forEach(function (p) {
    $(p[0]).addEventListener('change', function () { filters[p[1]] = this.value; render(); });
  });
  $('fClear').addEventListener('click', function () {
    filters = { stage: 'all', owner: 'all', status: 'all' };
    $('fStage').value = 'all'; $('fOwner').value = 'all'; $('fStatus').value = 'all';
    render();
  });

  /* ---------- Start ---------- */
  TaskStore.init();
  TaskStore.subscribe(render);
  render();
  window.addEventListener('storage', function (e) { if (e.key === STORAGE_KEY) TaskStore.reload(); });
})();
</script>

</body></html>
